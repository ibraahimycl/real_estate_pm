# Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Yalnızca sunucu tarafında kullanılır, tarayıcıya ASLA gönderilmez
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — AI görüşme ve talep eşleştirme modülü
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------
# AI maliyet frenleri
# AI_KAPALI=true yapılırsa tüm AI çağrıları durur, sistem kural
# tabanlı yedekle çalışmaya devam eder.
# ---------------------------------------------------------------
AI_KAPALI=false
AI_GORUSME_MESAJ_SINIRI=20
AI_GUNLUK_CAGRI_SINIRI=200
